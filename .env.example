# GEWUZAOJING shared LLM connection
SHARED_LLM_PROVIDER=openai-compatible
SHARED_LLM_API_KEY=replace-with-real-secret
SHARED_LLM_BASE_URL=https://api.deepseek.com/v1
ECHO_LLM_SOURCE=shared
QUILLFORGE_LLM_SOURCE=shared

# Task models
ECHO_CHAT_MODEL=deepseek-chat
ECHO_QUEST_MODEL=deepseek-chat
QUILLFORGE_RUNTIME_MODEL=deepseek-v4-flash
QUILLFORGE_SCRIPT_MODEL=deepseek-v4-flash
QUILLFORGE_DEBATE_MODEL=deepseek-v4-flash
QUILLFORGE_MINIGAME_MODEL=deepseek-v4-flash

# Local services
ECHO_HOST=127.0.0.1
ECHO_PORT=5000
QUILLFORGE_HOST=127.0.0.1
QUILLFORGE_PORT=8050
QUILLFORGE_ECHO_ENTRY_ENABLED=true
QUILLFORGE_OPEN_BROWSER=true

# To use separate APIs, set both selectors to dedicated and uncomment all six lines
# ECHO_LLM_PROVIDER=openai-compatible
# ECHO_LLM_API_KEY=replace-with-echo-secret
# ECHO_LLM_BASE_URL=https://echo-provider.example/v1
# QUILLFORGE_LLM_PROVIDER=openai-compatible
# QUILLFORGE_LLM_API_KEY=replace-with-quillforge-secret
# QUILLFORGE_LLM_BASE_URL=https://quillforge-provider.example/v1

# Optional QuillForge image and speech settings also belong in the root file
# IMAGE_API_KEY=replace-with-image-secret
# IMAGE_BASE_URL=https://image-provider.example/v1
# IMAGE_MODEL=image-model
# TTS_API_KEY=replace-with-tts-secret
# TTS_BASE_URL=https://tts-provider.example/v1
# TTS_MODEL=tts-model
